{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git config core.hooksPath .githooks",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_CODE_REMOTE_SESSION_ID\" ] || exit 0; python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/agents-md-nudge.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-merge-approval.py\"",
            "timeout": 330
          }
        ]
      },
      {
        "matcher": "mcp__ccd_pr__set_auto_merge",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-merge-approval.py\"",
            "timeout": 330
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-main-checkout.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_CODE_REMOTE_SESSION_ID\" ] || exit 0; bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/plan-intent.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/record-merge-approval.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$CLAUDE_CODE_REMOTE_SESSION_ID\" ] || exit 0; python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/subagent-comms-rules.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
